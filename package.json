{
  "name": "hina",
  "version": "2.5.3",
  "description": "A multi-purpose discord bot.",
  "main": "app.js",
  "type": "module",
  "dependencies": {
    "@prisma/client": "^7.4.2",
    "discord.js": "^14.25.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "piston-client": "^1.0.2"
  },
  "devDependencies": {
    "@fr0xty/prettier-config": "^1.0.2",
    "@types/express": "^5.0.6",
    "@types/node": "^25.1.0",
    "prisma": "^7.4.1",
    "typescript": "^5.9.3"
  },
  "prettier": "@fr0xty/prettier-config",
  "scripts": {
    "start": "docker compose up -d --build",
    "down": "docker compose down",
    "dev:generate": "npx prisma generate",
    "dev:migrate": "npm run start && docker compose exec bot npx prisma migrate dev && npm run down",
    "docker:build": "npm run dev:generate && tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fr0xty/Hina.git"
  },
